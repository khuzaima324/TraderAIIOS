# ---------------------------------------------------
# NATIVE DIRECTORIES (Crucial for Xcode Cloud & Android)
# ---------------------------------------------------

# iOS
ios/Pods/
ios/build/
ios/Index/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/*.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Android
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/local.properties

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/


.env

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
